# Copy to .env.local and fill in real values.

# Backend JSON API base URL — the FastAPI app from mahi80/planly.
# Local dev: assumes `uv run uvicorn api.main:app --port 8000` in the planly repo.
# Production: set to the deployed API hostname (e.g. https://api.pdintel.co.uk).
NEXT_PUBLIC_API_URL=http://localhost:8000

# NextAuth.js v5 (Auth.js)
# Generate with: openssl rand -hex 32
NEXTAUTH_SECRET=replace-with-32-hex-chars
NEXTAUTH_URL=http://localhost:3000
